<section class="section-spacing" id="FeaturedProducts-{{ section.id }}">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">{{ section.settings.subtitle | default: 'Precision Gear' }}</span>
      <h2 class="section-title">{{ section.settings.title | default: 'TACTICAL & HOROLOGY BEST SELLERS' }}</h2>
      <p class="section-description">
        {{ section.settings.description | default: 'Tested under simulated sub-zero polar storms, high-altitude drops, and deep oceanic pressures.' }}
      </p>
    </div>

    <!-- Product Grid with Dynamic Cards -->
    <div class="grid grid-cols-4">
      
      <!-- Product 1: Apex Pro Smartwatch -->
      <div class="product-card" data-product-handle="kinetix-apex-pro">
        <div class="product-card__image-wrapper">
          <div class="product-card__badges">
            <span class="badge badge-sale">-24% OFF</span>
            <span class="badge badge-new">APEX TECH</span>
          </div>
          <div class="product-card__actions">
            <button type="button" class="btn-icon" data-quick-view data-product-handle="kinetix-apex-pro" aria-label="Quick View">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <a href="/products/kinetix-apex-pro" class="product-card__image-link">
            <img src="{{ 'watch-apex-pro.jpg' | asset_url }}" alt="Kinetix Apex Pro Smartwatch" class="product-card__image" loading="lazy" width="600" height="750">
          </a>
          <div class="product-card__quick-add">
            <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-btn data-product-title="Kinetix Apex Pro Smartwatch" data-product-price="249.00">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>Quick Add</span>
            </button>
          </div>
        </div>
        <div class="product-card__content">
          <div class="product-card__vendor">Kinetix Apex Series</div>
          <h3 class="product-card__title"><a href="/products/kinetix-apex-pro">Kinetix Apex Pro Titanium Smartwatch</a></h3>
          <div class="product-card__rating">
            <div class="rating-stars" style="display:flex; gap:2px; color:var(--accent-gold);">
              {%- for i in (1..5) -%}{% render 'icon-star', filled: true %}{%- endfor -%}
            </div>
            <span style="font-size:0.8rem; color:var(--text-muted); margin-left:4px;">(4.9)</span>
          </div>
          <div class="product-card__price-wrapper">
            <span class="product-price">$249.00</span>
            <span class="product-price--compare">$329.00</span>
            <span class="product-price--save">SAVE 24%</span>
          </div>
        </div>
      </div>

      <!-- Product 2: Thrux Military Tactical GPS -->
      <div class="product-card" data-product-handle="kinetix-thrux-military">
        <div class="product-card__image-wrapper">
          <div class="product-card__badges">
            <span class="badge badge-sale">-24% OFF</span>
            <span class="badge badge-featured">MIL-SPEC 810H</span>
          </div>
          <div class="product-card__actions">
            <button type="button" class="btn-icon" data-quick-view data-product-handle="kinetix-thrux-military" aria-label="Quick View">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <a href="/products/kinetix-thrux-military" class="product-card__image-link">
            <img src="{{ 'watch-thrux-military.jpg' | asset_url }}" alt="Kinetix Thrux Military GPS Smartwatch" class="product-card__image" loading="lazy" width="600" height="750">
          </a>
          <div class="product-card__quick-add">
            <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-btn data-product-title="Kinetix Thrux Military GPS" data-product-price="189.00">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>Quick Add</span>
            </button>
          </div>
        </div>
        <div class="product-card__content">
          <div class="product-card__vendor">Tactical Armor</div>
          <h3 class="product-card__title"><a href="/products/kinetix-thrux-military">Kinetix Thrux Rugged Military GPS (170 Sports Modes)</a></h3>
          <div class="product-card__rating">
            <div class="rating-stars" style="display:flex; gap:2px; color:var(--accent-gold);">
              {%- for i in (1..5) -%}{% render 'icon-star', filled: true %}{%- endfor -%}
            </div>
            <span style="font-size:0.8rem; color:var(--text-muted); margin-left:4px;">(4.95)</span>
          </div>
          <div class="product-card__price-wrapper">
            <span class="product-price">$189.00</span>
            <span class="product-price--compare">$249.00</span>
            <span class="product-price--save">SAVE 24%</span>
          </div>
        </div>
      </div>

      <!-- Product 3: Heritage Royale Luxury Chronograph -->
      <div class="product-card" data-product-handle="kinetix-heritage-royale">
        <div class="product-card__image-wrapper">
          <div class="product-card__badges">
            <span class="badge badge-sale">-25% OFF</span>
            <span class="badge" style="background: rgba(245,158,11,0.2); color: var(--accent-gold);">ROYALE</span>
          </div>
          <div class="product-card__actions">
            <button type="button" class="btn-icon" data-quick-view data-product-handle="kinetix-heritage-royale" aria-label="Quick View">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <a href="/products/kinetix-heritage-royale" class="product-card__image-link">
            <img src="{{ 'watch-heritage-royale.jpg' | asset_url }}" alt="Kinetix Heritage Royale Chronograph" class="product-card__image" loading="lazy" width="600" height="750">
          </a>
          <div class="product-card__quick-add">
            <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-btn data-product-title="Kinetix Heritage Royale Chronograph" data-product-price="299.00">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>Quick Add</span>
            </button>
          </div>
        </div>
        <div class="product-card__content">
          <div class="product-card__vendor">Horology Royale</div>
          <h3 class="product-card__title"><a href="/products/kinetix-heritage-royale">Heritage Royale Teal & Rose Gold Smart Chronograph</a></h3>
          <div class="product-card__rating">
            <div class="rating-stars" style="display:flex; gap:2px; color:var(--accent-gold);">
              {%- for i in (1..5) -%}{% render 'icon-star', filled: true %}{%- endfor -%}
            </div>
            <span style="font-size:0.8rem; color:var(--text-muted); margin-left:4px;">(5.0)</span>
          </div>
          <div class="product-card__price-wrapper">
            <span class="product-price">$299.00</span>
            <span class="product-price--compare">$399.00</span>
            <span class="product-price--save">SAVE 25%</span>
          </div>
        </div>
      </div>

      <!-- Product 4: Pulse Elite Active ECG -->
      <div class="product-card" data-product-handle="kinetix-pulse-elite">
        <div class="product-card__image-wrapper">
          <div class="product-card__badges">
            <span class="badge badge-sale">-25% OFF</span>
            <span class="badge" style="background: rgba(16,185,129,0.2); color: #34d399;">BIOPULSE</span>
          </div>
          <div class="product-card__actions">
            <button type="button" class="btn-icon" data-quick-view data-product-handle="kinetix-pulse-elite" aria-label="Quick View">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <a href="/products/kinetix-pulse-elite" class="product-card__image-link">
            <img src="{{ 'watch-pulse-elite.jpg' | asset_url }}" alt="Kinetix Pulse Elite Fitness ECG" class="product-card__image" loading="lazy" width="600" height="750">
          </a>
          <div class="product-card__quick-add">
            <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-btn data-product-title="Kinetix Pulse Elite ECG" data-product-price="149.00">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>Quick Add</span>
            </button>
          </div>
        </div>
        <div class="product-card__content">
          <div class="product-card__vendor">BioTelemetry Series</div>
          <h3 class="product-card__title"><a href="/products/kinetix-pulse-elite">Kinetix Pulse Elite Curved OLED Fitness & ECG Tracker</a></h3>
          <div class="product-card__rating">
            <div class="rating-stars" style="display:flex; gap:2px; color:var(--accent-gold);">
              {%- for i in (1..5) -%}{% render 'icon-star', filled: true %}{%- endfor -%}
            </div>
            <span style="font-size:0.8rem; color:var(--text-muted); margin-left:4px;">(4.88)</span>
          </div>
          <div class="product-card__price-wrapper">
            <span class="product-price">$149.00</span>
            <span class="product-price--compare">$199.00</span>
            <span class="product-price--save">SAVE 25%</span>
          </div>
        </div>
      </div>

    </div>

    <!-- View All CTA -->
    <div style="text-align: center; margin-top: 48px;">
      <a href="/collections/all" class="btn btn-secondary btn-lg">
        <span>Explore Full Catalog (12 Models)</span>
        {% render 'icon-arrow' %}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Precision Gear"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "TACTICAL & HOROLOGY BEST SELLERS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Tested under simulated sub-zero polar storms, high-altitude drops, and deep oceanic pressures."
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
