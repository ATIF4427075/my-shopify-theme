<div class="cart-page section-spacing" id="MainCart-{{ section.id }}">
  <div class="container">
    <div class="section-header text-left">
      <span class="section-subtitle">Tactical Gear Order</span>
      <h1 class="section-title">YOUR SHOPPING CART</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart__form">
        <div style="display: grid; grid-template-columns: 1fr 380px; gap: 48px; align-items: start;">
          
          <!-- Items Column -->
          <div class="glass-card" style="padding: 32px;">
            <table style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr style="border-bottom: 1px solid var(--border-subtle); font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); text-align: left;">
                  <th style="padding-bottom: 16px;">Product</th>
                  <th style="padding-bottom: 16px; text-align: center;">Quantity</th>
                  <th style="padding-bottom: 16px; text-align: right;">Total</th>
                </tr>
              </thead>
              <tbody>
                {%- for item in cart.items -%}
                  <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                    <td style="padding: 24px 0; display: flex; gap: 20px; align-items: center;">
                      <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" style="width: 84px; height: 84px; border-radius: var(--radius-md); object-fit: cover;">
                      <div>
                        <h4 style="font-size: 1.05rem; margin-bottom: 4px;"><a href="{{ item.url }}" style="color: var(--text-primary);">{{ item.product.title }}</a></h4>
                        <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">{{ item.variant.title }}</div>
                        <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="font-size: 0.8rem; color: #fb7185;">Remove</a>
                      </div>
                    </td>
                    <td style="padding: 24px 0; text-align: center;">
                      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width: 60px; padding: 8px; text-align: center; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--text-primary); background: rgba(255,255,255,0.04);">
                    </td>
                    <td style="padding: 24px 0; text-align: right; font-weight: 700; color: var(--accent-gold); font-size: 1.1rem;">
                      {{ item.final_line_price | money }}
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>

            <div style="margin-top: 24px; display: flex; justify-content: space-between; align-items: center;">
              <a href="/collections/all" class="btn btn-outline btn-sm">&larr; Continue Exploring Watches</a>
              <button type="submit" name="update" class="btn btn-secondary btn-sm">Update Cart</button>
            </div>
          </div>

          <!-- Summary Column -->
          <div class="glass-card" style="padding: 32px; border: 1px solid var(--border-active);">
            <h3 style="font-size: 1.3rem; margin-bottom: 20px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px;">Order Summary</h3>
            
            <div style="display: flex; justify-content: space-between; margin-bottom: 14px; font-size: 0.95rem;">
              <span style="color: var(--text-secondary);">Subtotal</span>
              <span style="font-weight: 700; color: var(--text-primary);">{{ cart.total_price | money }}</span>
            </div>

            <div style="display: flex; justify-content: space-between; margin-bottom: 20px; font-size: 0.95rem;">
              <span style="color: var(--text-secondary);">Worldwide Shipping</span>
              <span style="color: #10b981; font-weight: 700;">FREE</span>
            </div>

            <div style="display: flex; justify-content: space-between; margin-bottom: 24px; padding-top: 16px; border-top: 1px solid var(--border-subtle); font-size: 1.3rem; font-weight: 800;">
              <span>Total</span>
              <span style="color: var(--accent-gold); font-family: var(--font-heading);">{{ cart.total_price | money }}</span>
            </div>

            <button type="submit" name="checkout" class="btn btn-primary btn-full btn-lg" style="margin-bottom: 16px;">
              <span>Proceed to Checkout</span>
              {% render 'icon-arrow' %}
            </button>

            <div style="font-size: 0.8rem; color: var(--text-muted); text-align: center; line-height: 1.5;">
              🔒 256-Bit SSL Encrypted Checkout • Includes 2-Year International Warranty
            </div>
          </div>

        </div>
      </form>
    {%- else -%}
      <div class="glass-card" style="padding: 64px 32px; text-align: center; max-width: 600px; margin: 0 auto;">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(245,158,11,0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; color: var(--accent-gold);">
          {% render 'icon-cart' %}
        </div>
        <h2 style="font-size: 1.8rem; margin-bottom: 12px;">Your Cart is Empty</h2>
        <p style="color: var(--text-secondary); margin-bottom: 28px;">
          You haven't added any high-performance tactical smart instruments to your cart yet.
        </p>
        <a href="/collections/all" class="btn btn-primary btn-lg">
          <span>Explore Watch Catalog</span>
          {% render 'icon-arrow' %}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<style>
@media (max-width: 900px) {
  .cart-page .cart__form > div { grid-template-columns: 1fr !important; }
}
</style>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
