<div class="section-spacing text-center" id="Main404-{{ section.id }}">
  <div class="container" style="max-width: 680px; margin: 0 auto;">
    <div class="glass-card" style="padding: clamp(48px, 8vw, 80px); text-align: center;">
      <span class="badge badge-sale" style="margin-bottom: 16px;">COORDINATES UNKNOWN (404)</span>
      <h1 style="font-size: clamp(3rem, 6vw, 5rem); color: var(--accent-gold); line-height: 1; margin-bottom: 16px;">404</h1>
      <h2 style="font-size: 1.6rem; margin-bottom: 16px;">Telemetry Signal Lost</h2>
      <p style="color: var(--text-secondary); font-size: 1.05rem; margin-bottom: 36px; line-height: 1.7;">
        The requested navigational waypoint does not exist or has been relocated to new orbital coordinates.
      </p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary btn-lg">Return to Command Center</a>
        <a href="/collections/all" class="btn btn-secondary btn-lg">Browse Smartwatches</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main 404",
  "settings": []
}
{% endschema %}
