[
  {
    "name": "theme_info",
    "theme_name": "Kinetix Pro - Luxury & Military Smartwatches",
    "theme_author": "Kinetix Engineering",
    "theme_version": "2.1.0",
    "theme_documentation_url": "https://kinetixpro-watches.com/docs",
    "theme_support_url": "https://kinetixpro-watches.com/support"
  },
  {
    "name": "Colors & Aesthetics",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Background",
        "default": "#090d16"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / Card Background",
        "default": "#0f172a"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent Gold / Amber",
        "default": "#f59e0b"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Primary Text",
        "default": "#f8fafc"
      }
    ]
  },
  {
    "name": "WhatsApp Live Chat & Orders",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp Business Number (with country code)",
        "default": "+923001234567"
      },
      {
        "type": "textarea",
        "id": "whatsapp_default_message",
        "label": "Default WhatsApp Order Message",
        "default": "Hi Kinetix Pro, I would like to inquire about ordering a smartwatch."
      }
    ]
  },
  {
    "name": "Cart, COD & Shipping Goals",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold ($)",
        "default": 150
      },
      {
        "type": "checkbox",
        "id": "enable_cod",
        "label": "Enable Cash on Delivery (COD)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Enable Slide-out AJAX Cart Drawer",
        "default": true
      }
    ]
  },
  {
    "name": "Social Media & SEO",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL",
        "default": "https://instagram.com"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube URL",
        "default": "https://youtube.com"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter / X URL",
        "default": "https://twitter.com"
      }
    ]
  }
]
