<div class="main-page section-spacing" id="MainPage-{{ section.id }}">
  <div class="container" style="max-width: 860px; margin: 0 auto;">
    <div class="glass-card" style="padding: clamp(32px, 6vw, 64px);">
      <h1 style="font-size: clamp(2rem, 3.5vw, 2.8rem); margin-bottom: 24px;">{{ page.title }}</h1>
      <div class="page-content" style="color: var(--text-secondary); font-size: 1.05rem; line-height: 1.8;">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Page",
  "settings": []
}
{% endschema %}
