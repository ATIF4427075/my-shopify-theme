<section class="section-spacing" id="TechSpecs-{{ section.id }}" style="background: var(--bg-surface); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">{{ section.settings.subtitle | default: 'Telemetry & Engineering' }}</span>
      <h2 class="section-title">{{ section.settings.title | default: 'FLAGSHIP SPECIFICATIONS COMPARISON' }}</h2>
      <p class="section-description">
        {{ section.settings.description | default: 'Direct side-by-side engineering telemetry metrics across the Kinetix Pro model series.' }}
      </p>
    </div>

    <!-- Interactive Comparison Matrix Table -->
    <div class="glass-card" style="overflow-x: auto; padding: 0; border-radius: var(--radius-xl);">
      <table style="width: 100%; min-width: 780px; border-collapse: collapse; text-align: left;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border-subtle); background: rgba(255,255,255,0.02);">
            <th style="padding: 24px; font-family: var(--font-heading); font-size: 1.1rem; color: var(--text-primary); width: 28%;">Specification</th>
            <th style="padding: 24px; font-family: var(--font-heading); font-size: 1.1rem; color: var(--accent-gold); width: 24%;">
              Apex Pro Titanium
              <span class="badge badge-new" style="display: block; margin-top: 6px; width: fit-content;">Flagship</span>
            </th>
            <th style="padding: 24px; font-family: var(--font-heading); font-size: 1.1rem; color: var(--text-primary); width: 24%;">Thrux Military GPS</th>
            <th style="padding: 24px; font-family: var(--font-heading); font-size: 1.1rem; color: var(--text-primary); width: 24%;">Heritage Royale</th>
          </tr>
        </thead>
        <tbody style="font-size: 0.92rem;">
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
            <td style="padding: 18px 24px; color: var(--text-secondary); font-weight: 600;">Chassis & Bezel Material</td>
            <td style="padding: 18px 24px; color: var(--accent-gold); font-weight: 700;">Aerospace Grade 5 Titanium</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">Reinforced Polycarbonate + Steel</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">18K Rose Gold Ion-Plated 316L</td>
          </tr>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); background: rgba(255,255,255,0.01);">
            <td style="padding: 18px 24px; color: var(--text-secondary); font-weight: 600;">Water Resistance Rating</td>
            <td style="padding: 18px 24px; color: var(--accent-gold); font-weight: 700;">10 ATM (100 Meters / 330 Ft)</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">5 ATM (50 Meters)</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">3 ATM Splashproof</td>
          </tr>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
            <td style="padding: 18px 24px; color: var(--text-secondary); font-weight: 600;">Battery Endurance</td>
            <td style="padding: 18px 24px; color: var(--accent-gold); font-weight: 700;">45 Days (Eco) / 18 Days (Heavy)</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">30 Days Ultra Runtime</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">14 Days Smart Hybrid</td>
          </tr>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); background: rgba(255,255,255,0.01);">
            <td style="padding: 18px 24px; color: var(--text-secondary); font-weight: 600;">Satellite Positioning</td>
            <td style="padding: 18px 24px; color: var(--accent-gold); font-weight: 700;">Dual-Freq L1+L5 (6 Constellations)</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">Multi-GNSS Precision GPS</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">Connected Phone Assisted GPS</td>
          </tr>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
            <td style="padding: 18px 24px; color: var(--text-secondary); font-weight: 600;">Glass Display Protection</td>
            <td style="padding: 18px 24px; color: var(--accent-gold); font-weight: 700;">Synthetic Sapphire Crystal (9H)</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">Corning Gorilla Glass Victus</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">Mineral Hardlex Domed Glass</td>
          </tr>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); background: rgba(255,255,255,0.01);">
            <td style="padding: 18px 24px; color: var(--text-secondary); font-weight: 600;">Tactical Sports Modes</td>
            <td style="padding: 18px 24px; color: var(--accent-gold); font-weight: 700;">170+ Modes with Auto-Recognition</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">170+ Sports & Outdoor Tracking</td>
            <td style="padding: 18px 24px; color: var(--text-primary);">40+ Core Fitness Modes</td>
          </tr>
          <tr>
            <td style="padding: 24px; color: var(--text-secondary); font-weight: 600;">Price</td>
            <td style="padding: 24px;">
              <span style="font-size: 1.3rem; font-weight: 800; color: var(--accent-gold);">$249.00</span>
              <a href="/products/kinetix-apex-pro" class="btn btn-primary btn-sm" style="display: block; margin-top: 8px;">Order Apex Pro</a>
            </td>
            <td style="padding: 24px;">
              <span style="font-size: 1.3rem; font-weight: 800; color: var(--text-primary);">$189.00</span>
              <a href="/products/kinetix-thrux-military" class="btn btn-secondary btn-sm" style="display: block; margin-top: 8px;">Order Thrux</a>
            </td>
            <td style="padding: 24px;">
              <span style="font-size: 1.3rem; font-weight: 800; color: var(--text-primary);">$299.00</span>
              <a href="/products/kinetix-heritage-royale" class="btn btn-secondary btn-sm" style="display: block; margin-top: 8px;">Order Royale</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tech Specs Matrix",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Telemetry & Engineering"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "FLAGSHIP SPECIFICATIONS COMPARISON"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Direct side-by-side engineering telemetry metrics across the Kinetix Pro model series."
    }
  ],
  "presets": [
    {
      "name": "Tech Specs Matrix"
    }
  ]
}
{% endschema %}
