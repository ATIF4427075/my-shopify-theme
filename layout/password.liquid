<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} &ndash; Opening Soon</title>
    {{ content_for_header }}
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'custom.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password theme-dark-mode">
    <div class="password-page-wrapper">
      <header class="password-header">
        <h1 class="logo-text">{{ shop.name }}</h1>
      </header>
      <main class="password-main">
        {{ content_for_layout }}
      </main>
      <footer class="password-footer">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>
