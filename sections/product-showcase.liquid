<section class="section-spacing" id="ProductShowcase-{{ section.id }}" style="background: radial-gradient(circle at 20% 50%, rgba(245, 158, 11, 0.05) 0%, rgba(9, 13, 22, 1) 100%);">
  <div class="container">
    <div class="glass-card" style="padding: clamp(24px, 5vw, 56px); border: 1px solid rgba(245, 158, 11, 0.25); position: relative; overflow: hidden;">
      
      <!-- Background Ambient Glow -->
      <div style="position: absolute; top: -100px; right: -100px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%); filter: blur(50px); pointer-events: none;"></div>

      <div class="grid grid-cols-2" style="align-items: center; gap: clamp(32px, 5vw, 64px);">
        <!-- Left: Interactive Visual with Hotspots -->
        <div class="showcase-visual-container" style="position: relative; display: flex; flex-direction: column; align-items: center;">
          <div style="position: relative; width: 100%; max-width: 480px;">
            <img
              id="showcase-main-img"
              src="{{ 'watch-apex-pro.jpg' | asset_url }}"
              alt="Kinetix Apex Pro Flagship"
              style="width: 100%; border-radius: var(--radius-lg); box-shadow: 0 20px 50px rgba(0,0,0,0.6); border: 1px solid var(--border-subtle);"
              width="600"
              height="600"
            >

            <!-- Interactive Hotspot 1: Sapphire Dial -->
            <div class="showcase-hotspot" style="position: absolute; top: 28%; left: 36%;" data-tooltip="Sapphire Crystal (9 Mohs Hardness)">
              <div class="hotspot-pulse"></div>
              <span class="hotspot-dot">1</span>
            </div>

            <!-- Interactive Hotspot 2: Titanium Crown -->
            <div class="showcase-hotspot" style="position: absolute; top: 48%; right: 18%;" data-tooltip="Dual Rotary Titanium Crown & Haptic Engine">
              <div class="hotspot-pulse"></div>
              <span class="hotspot-dot">2</span>
            </div>

            <!-- Interactive Hotspot 3: Tactical Strap -->
            <div class="showcase-hotspot" style="position: absolute; bottom: 20%; left: 45%;" data-tooltip="Fluoroelastomer Quick-Release 22mm Strap">
              <div class="hotspot-pulse"></div>
              <span class="hotspot-dot">3</span>
            </div>
          </div>

          <!-- Hotspot Info Display Banner -->
          <div class="hotspot-info-box" style="margin-top: 20px; width: 100%; max-width: 480px; padding: 12px 18px; background: rgba(255,255,255,0.04); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 10px;">
            <span style="color: var(--accent-gold); font-weight: 700;">💡 Tip:</span>
            <span id="hotspot-live-desc">Click any numbered hotspot on the watch to inspect aerospace engineering tolerances.</span>
          </div>
        </div>

        <!-- Right: Flagship Product Details & Actions -->
        <div class="showcase-details">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
            <span class="badge badge-new">Flagship Architecture</span>
            <div style="display: flex; align-items: center; gap: 4px; color: var(--accent-gold); font-size: 0.85rem;">
              {%- for i in (1..5) -%}
                {% render 'icon-star', filled: true %}
              {%- endfor -%}
              <span style="color: var(--text-muted); font-size: 0.8rem; margin-left: 4px;">4.98 / 5.0 (842 Verified Reviews)</span>
            </div>
          </div>

          <h2 style="font-size: clamp(2rem, 3.5vw, 2.8rem); margin-bottom: 12px; line-height: 1.1;">
            Kinetix Apex Pro
          </h2>

          <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 20px;">
            <span style="font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--text-primary);">$249.00</span>
            <span style="font-size: 1.2rem; color: var(--text-muted); text-decoration: line-through;">$329.00</span>
            <span class="badge badge-sale">Save $80 Today</span>
          </div>

          <p style="font-size: 1rem; color: var(--text-secondary); margin-bottom: 24px; line-height: 1.6;">
            The definitive tactical and luxury smart instrument. Built with aerospace Grade 5 titanium, equipped with dual-band 6-satellite positioning, clinical-grade ECG cardiac telemetry, and military drop certification.
          </p>

          <!-- Core Feature Pills -->
          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 28px;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem;">
              <span style="color: var(--accent-emerald);">{% render 'icon-check' %}</span>
              <span>10 ATM (100M) Waterproof</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem;">
              <span style="color: var(--accent-emerald);">{% render 'icon-check' %}</span>
              <span>45-Day Ultra Battery</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem;">
              <span style="color: var(--accent-emerald);">{% render 'icon-check' %}</span>
              <span>170+ Tactical Sports Modes</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem;">
              <span style="color: var(--accent-emerald);">{% render 'icon-check' %}</span>
              <span>Dual-Band L1+L5 GPS</span>
            </div>
          </div>

          <!-- Color / Finish Selector -->
          <div style="margin-bottom: 24px;">
            <label style="display: block; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; color: var(--text-secondary);">
              Finish & Chassis: <span id="selected-finish-name" style="color: var(--accent-gold);">Stealth Titanium Carbon</span>
            </label>
            <div style="display: flex; gap: 12px;">
              <button type="button" class="swatch-btn active" data-finish="Stealth Titanium Carbon" style="width: 36px; height: 36px; border-radius: 50%; background: #1e293b; border: 2px solid var(--accent-gold); box-shadow: 0 0 10px rgba(245,158,11,0.4);" title="Stealth Titanium Carbon"></button>
              <button type="button" class="swatch-btn" data-finish="Aero Silver Grade-5" style="width: 36px; height: 36px; border-radius: 50%; background: #94a3b8; border: 2px solid transparent;" title="Aero Silver Grade-5"></button>
              <button type="button" class="swatch-btn" data-finish="Tactical Desert Khaki" style="width: 36px; height: 36px; border-radius: 50%; background: #78716c; border: 2px solid transparent;" title="Tactical Desert Khaki"></button>
              <button type="button" class="swatch-btn" data-finish="Deep Marine Ocean" style="width: 36px; height: 36px; border-radius: 50%; background: #0e7490; border: 2px solid transparent;" title="Deep Marine Ocean"></button>
            </div>
          </div>

          <!-- Urgency Badge -->
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #fb7185; margin-bottom: 24px; padding: 8px 14px; background: rgba(244, 63, 94, 0.1); border-radius: var(--radius-md); border: 1px solid rgba(244, 63, 94, 0.25);">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #f43f5e; animation: pulseGlow 1s infinite alternate;"></span>
            <span>Only 4 units left in stock for priority express delivery.</span>
          </div>

          <!-- Add to Cart & Checkout CTAs -->
          <div style="display: flex; gap: 14px; flex-wrap: wrap;">
            <button
              type="button"
              class="btn btn-primary btn-lg"
              style="flex: 1; min-width: 200px;"
              data-quick-add-btn
              data-product-id="44647025840286"
              data-product-title="Kinetix Apex Pro Smartwatch"
              data-product-price="249.00"
            >
              <span>Add to Cart — $249</span>
            </button>
            <a href="/checkout" class="btn btn-secondary btn-lg">
              <span>Instant Buy</span>
            </a>
          </div>

          <div style="margin-top: 18px; font-size: 0.8rem; color: var(--text-muted); display: flex; align-items: center; gap: 16px;">
            <span>🛡️ 2-Year Global Warranty</span>
            <span>📦 Free Worldwide Express</span>
            <span>🔄 30-Day Risk-Free Trial</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.showcase-hotspot {
  width: 28px;
  height: 28px;
  cursor: pointer;
  position: absolute;
  z-index: 5;
}
.hotspot-dot {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--accent-gold);
  color: #090d16;
  font-weight: 800;
  font-size: 0.75rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 12px rgba(245, 158, 11, 0.8);
}
.hotspot-pulse {
  position: absolute;
  top: -4px;
  left: -4px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid var(--accent-gold);
  animation: pulseHotspot 2s infinite;
}
@keyframes pulseHotspot {
  0% { transform: scale(0.8); opacity: 1; }
  100% { transform: scale(1.6); opacity: 0; }
}
.swatch-btn {
  cursor: pointer;
  transition: transform var(--transition-fast), border-color var(--transition-fast);
}
.swatch-btn:hover {
  transform: scale(1.15);
}
.swatch-btn.active {
  border-color: var(--accent-gold) !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const hotspots = document.querySelectorAll('.showcase-hotspot');
  const infoDesc = document.getElementById('hotspot-live-desc');
  hotspots.forEach(h => {
    h.addEventListener('click', () => {
      const tip = h.getAttribute('data-tooltip');
      if (infoDesc && tip) {
        infoDesc.innerHTML = `<strong>Selected Component:</strong> ${tip}`;
        infoDesc.style.color = 'var(--text-primary)';
      }
    });
  });

  const swatches = document.querySelectorAll('.swatch-btn');
  const finishLabel = document.getElementById('selected-finish-name');
  swatches.forEach(s => {
    s.addEventListener('click', () => {
      swatches.forEach(el => el.classList.remove('active'));
      s.classList.add('active');
      if (finishLabel) {
        finishLabel.textContent = s.getAttribute('data-finish');
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Product Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kinetix Apex Pro"
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}
