<footer class="site-footer" style="background: #05080f; border-top: 1px solid var(--border-subtle); padding: 72px 0 36px 0;" role="contentinfo">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 56px;">
      
      <!-- Brand Col -->
      <div>
        <a href="/" class="site-header__logo" style="margin-bottom: 18px; display: inline-flex;">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; background:linear-gradient(135deg, var(--accent-gold), #d97706); border-radius:8px; color:#090d16; font-weight:900; font-size:1.1rem; margin-right:4px;">K</span>
          <span>KINETIX<span style="color:var(--accent-gold);">•</span>PRO</span>
        </a>
        <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 24px; max-width: 320px;">
          Pinnacle aerospace horology and mission-grade wearable computing. Engineered in Switzerland & Tokyo for elite operators worldwide.
        </p>
        <div style="display: flex; gap: 12px;">
          <a href="#" class="btn-icon" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" class="btn-icon" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          </a>
          <a href="#" class="btn-icon" aria-label="Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Watch Series -->
      <div>
        <h4 style="font-size: 1rem; color: var(--text-primary); margin-bottom: 20px; text-transform: uppercase; letter-spacing: 0.08em;">Watch Series</h4>
        <ul style="display: flex; flex-direction: column; gap: 12px; font-size: 0.9rem; color: var(--text-secondary);">
          <li><a href="/products/kinetix-apex-pro" style="color:var(--text-secondary); transition:color 0.2s;">Apex Pro Titanium</a></li>
          <li><a href="/products/kinetix-thrux-military" style="color:var(--text-secondary); transition:color 0.2s;">Thrux Tactical Military</a></li>
          <li><a href="/products/kinetix-heritage-royale" style="color:var(--text-secondary); transition:color 0.2s;">Heritage Royale Chronograph</a></li>
          <li><a href="/products/kinetix-pulse-elite" style="color:var(--text-secondary); transition:color 0.2s;">Pulse Elite Biometric ECG</a></li>
          <li><a href="/collections/all" style="color:var(--text-secondary); transition:color 0.2s;">Complete Catalog</a></li>
        </ul>
      </div>

      <!-- Col 3: Technology & Engineering -->
      <div>
        <h4 style="font-size: 1rem; color: var(--text-primary); margin-bottom: 20px; text-transform: uppercase; letter-spacing: 0.08em;">Technology</h4>
        <ul style="display: flex; flex-direction: column; gap: 12px; font-size: 0.9rem; color: var(--text-secondary);">
          <li><a href="/pages/about" style="color:var(--text-secondary); transition:color 0.2s;">Grade-5 Titanium Forging</a></li>
          <li><a href="/pages/about" style="color:var(--text-secondary); transition:color 0.2s;">BioPulse™ 8-Channel Sensor</a></li>
          <li><a href="/pages/about" style="color:var(--text-secondary); transition:color 0.2s;">Dual-Band L1+L5 GPS</a></li>
          <li><a href="/pages/about" style="color:var(--text-secondary); transition:color 0.2s;">Polar & Desert Stress Testing</a></li>
          <li><a href="/pages/about" style="color:var(--text-secondary); transition:color 0.2s;">Firmware Release Notes</a></li>
        </ul>
      </div>

      <!-- Col 4: Support & Legal -->
      <div>
        <h4 style="font-size: 1rem; color: var(--text-primary); margin-bottom: 20px; text-transform: uppercase; letter-spacing: 0.08em;">Operator Support</h4>
        <ul style="display: flex; flex-direction: column; gap: 12px; font-size: 0.9rem; color: var(--text-secondary);">
          <li><a href="/pages/support" style="color:var(--text-secondary); transition:color 0.2s;">Track Order & Dispatch</a></li>
          <li><a href="/pages/support" style="color:var(--text-secondary); transition:color 0.2s;">2-Year Global Warranty</a></li>
          <li><a href="/pages/support" style="color:var(--text-secondary); transition:color 0.2s;">User Manuals & Pairing</a></li>
          <li><a href="/pages/support" style="color:var(--text-secondary); transition:color 0.2s;">Returns & 30-Day Trial</a></li>
          <li><a href="/pages/support" style="color:var(--text-secondary); transition:color 0.2s;">Contact VIP Technical Desk</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div style="padding-top: 32px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; font-size: 0.85rem; color: var(--text-muted);">
      <div>
        &copy; {{ 'now' | date: '%Y' }} Kinetix Pro Smartwatches. All Rights Reserved. Swiss & Tokyo Engineering Labs.
      </div>

      <div style="display: flex; align-items: center; gap: 16px;">
        <span style="padding: 4px 8px; background: rgba(255,255,255,0.05); border-radius: 4px; font-size: 0.75rem; font-weight: 700;">VISA</span>
        <span style="padding: 4px 8px; background: rgba(255,255,255,0.05); border-radius: 4px; font-size: 0.75rem; font-weight: 700;">MASTERCARD</span>
        <span style="padding: 4px 8px; background: rgba(255,255,255,0.05); border-radius: 4px; font-size: 0.75rem; font-weight: 700;">APPLE PAY</span>
        <span style="padding: 4px 8px; background: rgba(255,255,255,0.05); border-radius: 4px; font-size: 0.75rem; font-weight: 700;">SHOP PAY</span>
        <span style="padding: 4px 8px; background: rgba(255,255,255,0.05); border-radius: 4px; font-size: 0.75rem; font-weight: 700;">PAYPAL</span>
      </div>
    </div>
  </div>
</footer>

<style>
@media (max-width: 900px) {
  .site-footer > .container > div:first-child {
    grid-template-columns: 1fr 1fr !important;
  }
}
@media (max-width: 600px) {
  .site-footer > .container > div:first-child {
    grid-template-columns: 1fr !important;
  }
}
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_about",
      "label": "About Text",
      "default": "Pinnacle aerospace horology and mission-grade wearable computing."
    }
  ]
}
{% endschema %}
