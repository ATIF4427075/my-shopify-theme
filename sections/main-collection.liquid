<div class="collection-page section-spacing" id="MainCollection-{{ section.id }}">
  <div class="container">
    
    <!-- Collection Banner -->
    <div class="glass-card" style="padding: clamp(32px, 5vw, 56px); margin-bottom: 48px; position: relative; overflow: hidden; background: radial-gradient(circle at 80% 50%, rgba(245, 158, 11, 0.1) 0%, rgba(19, 29, 49, 0.9) 100%);">
      <span class="badge badge-new" style="margin-bottom: 12px;">OFFICIAL 2026 CATALOG</span>
      <h1 style="font-size: clamp(2.2rem, 4vw, 3.2rem); margin-bottom: 12px;">{{ collection.title | default: 'Tactical & Luxury Smartwatches' }}</h1>
      <p style="max-width: 680px; color: var(--text-secondary); font-size: 1.05rem;">
        {{ collection.description | default: 'Engineered for extreme environments, athletic supremacy, and executive elegance. Milled from Grade 5 titanium, equipped with sapphire glass and dual-frequency GPS.' }}
      </p>
    </div>

    <!-- Collection Layout: Sidebar Filters + Products Grid -->
    <div style="display: grid; grid-template-columns: 280px 1fr; gap: 36px; align-items: start;">
      
      <!-- Filters Sidebar -->
      <aside class="collection-filters glass-card" style="padding: 28px; border-radius: var(--radius-lg); position: sticky; top: 100px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
          <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Refine Telemetry</h3>
          <button type="button" style="font-size: 0.8rem; color: var(--accent-gold); font-weight: 600;" onclick="location.reload()">Reset All</button>
        </div>

        <!-- Filter Group 1: Series -->
        <div style="margin-bottom: 24px;">
          <h4 style="font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); margin-bottom: 12px;">Watch Series</h4>
          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem;">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" checked style="accent-color: var(--accent-gold);">
              <span>Apex Titanium Series</span>
            </label>
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" checked style="accent-color: var(--accent-gold);">
              <span>Military Tactical GPS</span>
            </label>
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" checked style="accent-color: var(--accent-gold);">
              <span>Luxury Chronograph</span>
            </label>
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" checked style="accent-color: var(--accent-gold);">
              <span>Pulse Elite Health ECG</span>
            </label>
          </div>
        </div>

        <!-- Filter Group 2: Water Resistance -->
        <div style="margin-bottom: 24px;">
          <h4 style="font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); margin-bottom: 12px;">Water Rating</h4>
          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem;">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" checked style="accent-color: var(--accent-gold);">
              <span>10 ATM (100M Deep Ocean)</span>
            </label>
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" checked style="accent-color: var(--accent-gold);">
              <span>5 ATM (50M Swimming)</span>
            </label>
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" style="accent-color: var(--accent-gold);">
              <span>3 ATM Splashproof</span>
            </label>
          </div>
        </div>

        <!-- Filter Group 3: Price Range -->
        <div>
          <h4 style="font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); margin-bottom: 12px;">Price Range</h4>
          <div style="display: flex; align-items: center; gap: 8px;">
            <input type="text" class="form-input" value="$149" style="padding: 8px 12px; font-size: 0.85rem;" readonly>
            <span>-</span>
            <input type="text" class="form-input" value="$399" style="padding: 8px 12px; font-size: 0.85rem;" readonly>
          </div>
        </div>
      </aside>

      <!-- Products Grid & Toolbar -->
      <div>
        <!-- Toolbar -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--border-subtle); flex-wrap: wrap; gap: 16px;">
          <div style="font-size: 0.9rem; color: var(--text-secondary);">
            Showing <strong style="color: var(--text-primary);">4 of 4</strong> High-Precision Instruments
          </div>
          
          <div style="display: flex; align-items: center; gap: 12px;">
            <label style="font-size: 0.85rem; color: var(--text-muted);">Sort By:</label>
            <select class="form-select" style="padding: 8px 16px; width: auto; font-size: 0.85rem;">
              <option value="featured">Featured Tier</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="rating">Top Rated (4.9+)</option>
            </select>
          </div>
        </div>

        <!-- Grid Cards -->
        <div class="grid grid-cols-2" style="gap: 28px;">
          
          <!-- Product Card 1 -->
          <div class="product-card" data-product-handle="kinetix-apex-pro">
            <div class="product-card__image-wrapper">
              <div class="product-card__badges">
                <span class="badge badge-sale">-24% OFF</span>
                <span class="badge badge-new">APEX TECH</span>
              </div>
              <div class="product-card__actions">
                <button type="button" class="btn-icon" data-quick-view data-product-handle="kinetix-apex-pro" aria-label="Quick View">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
              <a href="/products/kinetix-apex-pro">
                <img src="{{ 'watch-apex-pro.jpg' | asset_url }}" alt="Kinetix Apex Pro Smartwatch" class="product-card__image" loading="lazy" width="600" height="750">
              </a>
              <div class="product-card__quick-add">
                <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-btn data-product-title="Kinetix Apex Pro Smartwatch" data-product-price="249.00">Quick Add</button>
              </div>
            </div>
            <div class="product-card__content">
              <div class="product-card__vendor">Kinetix Apex Series</div>
              <h3 class="product-card__title"><a href="/products/kinetix-apex-pro">Kinetix Apex Pro Titanium Smartwatch</a></h3>
              <div class="product-card__rating">
                <div class="rating-stars" style="display:flex; gap:2px; color:var(--accent-gold);">{%- for i in (1..5) -%}{% render 'icon-star', filled: true %}{%- endfor -%}</div>
                <span style="font-size:0.8rem; color:var(--text-muted); margin-left:4px;">(4.9)</span>
              </div>
              <div class="product-card__price-wrapper">
                <span class="product-price">$249.00</span>
                <span class="product-price--compare">$329.00</span>
                <span class="product-price--save">SAVE 24%</span>
              </div>
            </div>
          </div>

          <!-- Product Card 2 -->
          <div class="product-card" data-product-handle="kinetix-thrux-military">
            <div class="product-card__image-wrapper">
              <div class="product-card__badges">
                <span class="badge badge-sale">-24% OFF</span>
                <span class="badge badge-featured">MIL-SPEC 810H</span>
              </div>
              <div class="product-card__actions">
                <button type="button" class="btn-icon" data-quick-view data-product-handle="kinetix-thrux-military" aria-label="Quick View">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
              <a href="/products/kinetix-thrux-military">
                <img src="{{ 'watch-thrux-military.jpg' | asset_url }}" alt="Kinetix Thrux Military GPS Smartwatch" class="product-card__image" loading="lazy" width="600" height="750">
              </a>
              <div class="product-card__quick-add">
                <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-btn data-product-title="Kinetix Thrux Military GPS" data-product-price="189.00">Quick Add</button>
              </div>
            </div>
            <div class="product-card__content">
              <div class="product-card__vendor">Tactical Armor</div>
              <h3 class="product-card__title"><a href="/products/kinetix-thrux-military">Kinetix Thrux Rugged Military GPS (170 Sports)</a></h3>
              <div class="product-card__rating">
                <div class="rating-stars" style="display:flex; gap:2px; color:var(--accent-gold);">{%- for i in (1..5) -%}{% render 'icon-star', filled: true %}{%- endfor -%}</div>
                <span style="font-size:0.8rem; color:var(--text-muted); margin-left:4px;">(4.95)</span>
              </div>
              <div class="product-card__price-wrapper">
                <span class="product-price">$189.00</span>
                <span class="product-price--compare">$249.00</span>
                <span class="product-price--save">SAVE 24%</span>
              </div>
            </div>
          </div>

          <!-- Product Card 3 -->
          <div class="product-card" data-product-handle="kinetix-heritage-royale">
            <div class="product-card__image-wrapper">
              <div class="product-card__badges">
                <span class="badge badge-sale">-25% OFF</span>
                <span class="badge" style="background: rgba(245,158,11,0.2); color: var(--accent-gold);">ROYALE</span>
              </div>
              <div class="product-card__actions">
                <button type="button" class="btn-icon" data-quick-view data-product-handle="kinetix-heritage-royale" aria-label="Quick View">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
              <a href="/products/kinetix-heritage-royale">
                <img src="{{ 'watch-heritage-royale.jpg' | asset_url }}" alt="Kinetix Heritage Royale Chronograph" class="product-card__image" loading="lazy" width="600" height="750">
              </a>
              <div class="product-card__quick-add">
                <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-btn data-product-title="Kinetix Heritage Royale Chronograph" data-product-price="299.00">Quick Add</button>
              </div>
            </div>
            <div class="product-card__content">
              <div class="product-card__vendor">Horology Royale</div>
              <h3 class="product-card__title"><a href="/products/kinetix-heritage-royale">Heritage Royale Teal & Rose Gold Smart Chronograph</a></h3>
              <div class="product-card__rating">
                <div class="rating-stars" style="display:flex; gap:2px; color:var(--accent-gold);">{%- for i in (1..5) -%}{% render 'icon-star', filled: true %}{%- endfor -%}</div>
                <span style="font-size:0.8rem; color:var(--text-muted); margin-left:4px;">(5.0)</span>
              </div>
              <div class="product-card__price-wrapper">
                <span class="product-price">$299.00</span>
                <span class="product-price--compare">$399.00</span>
                <span class="product-price--save">SAVE 25%</span>
              </div>
            </div>
          </div>

          <!-- Product Card 4 -->
          <div class="product-card" data-product-handle="kinetix-pulse-elite">
            <div class="product-card__image-wrapper">
              <div class="product-card__badges">
                <span class="badge badge-sale">-25% OFF</span>
                <span class="badge" style="background: rgba(16,185,129,0.2); color: #34d399;">BIOPULSE</span>
              </div>
              <div class="product-card__actions">
                <button type="button" class="btn-icon" data-quick-view data-product-handle="kinetix-pulse-elite" aria-label="Quick View">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
              <a href="/products/kinetix-pulse-elite">
                <img src="{{ 'watch-pulse-elite.jpg' | asset_url }}" alt="Kinetix Pulse Elite Fitness ECG" class="product-card__image" loading="lazy" width="600" height="750">
              </a>
              <div class="product-card__quick-add">
                <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-btn data-product-title="Kinetix Pulse Elite ECG" data-product-price="149.00">Quick Add</button>
              </div>
            </div>
            <div class="product-card__content">
              <div class="product-card__vendor">BioTelemetry Series</div>
              <h3 class="product-card__title"><a href="/products/kinetix-pulse-elite">Kinetix Pulse Elite Curved OLED Fitness & ECG Tracker</a></h3>
              <div class="product-card__rating">
                <div class="rating-stars" style="display:flex; gap:2px; color:var(--accent-gold);">{%- for i in (1..5) -%}{% render 'icon-star', filled: true %}{%- endfor -%}</div>
                <span style="font-size:0.8rem; color:var(--text-muted); margin-left:4px;">(4.88)</span>
              </div>
              <div class="product-card__price-wrapper">
                <span class="product-price">$149.00</span>
                <span class="product-price--compare">$199.00</span>
                <span class="product-price--save">SAVE 25%</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>
</div>

<style>
@media (max-width: 900px) {
  .collection-page .grid {
    grid-template-columns: 1fr !important;
  }
  .collection-filters {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
