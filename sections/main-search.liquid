<div class="search-page section-spacing" id="MainSearch-{{ section.id }}">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Database Search</span>
      <h1 class="section-title">TELEMETRY SEARCH</h1>
      
      <form action="{{ routes.search_url }}" method="get" role="search" style="max-width: 560px; margin: 32px auto 0 auto;">
        <div style="display: flex; gap: 12px;">
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search titanium, GPS, military, heart rate..."
            class="form-input"
            style="flex: 1; padding: 16px 24px; font-size: 1rem;"
          >
          <button type="submit" class="btn btn-primary btn-lg">Search</button>
        </div>
      </form>
    </div>

    {%- if search.performed -%}
      <div style="margin-top: 48px;">
        <div style="font-size: 1.1rem; margin-bottom: 24px; color: var(--text-secondary);">
          Results for <strong style="color: var(--accent-gold);">"{{ search.terms }}"</strong> ({{ search.results_count }} found):
        </div>

        <div class="grid grid-cols-4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Main Search",
  "settings": []
}
{% endschema %}
