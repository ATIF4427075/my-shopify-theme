<header class="site-header" role="banner">
  <div class="container">
    <div class="site-header__wrapper">
      <!-- Mobile Nav Trigger -->
      <button type="button" class="btn-icon mobile-nav-toggle" aria-label="Open navigation menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>

      <!-- Logo -->
      <div class="site-header__logo-container">
        <a href="{{ routes.root_url }}" class="site-header__logo">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; background:linear-gradient(135deg, var(--accent-gold), #d97706); border-radius:8px; color:#090d16; font-weight:900; font-size:1.1rem; margin-right:4px;">K</span>
          <span>KINETIX<span class="site-header__logo-sparkle" style="color:var(--accent-gold); font-size:1.4rem;">•</span>PRO</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="site-nav" role="navigation" aria-label="Main Navigation">
        {%- if section.settings.menu.links != blank -%}
          {%- for link in section.settings.menu.links -%}
            <a href="{{ link.url }}" class="site-nav__link {% if link.active %}active{% endif %}">
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback Navigation Links -->
          <a href="/collections/all" class="site-nav__link">Smartwatches</a>
          <a href="/collections/military-rugged" class="site-nav__link">Military Rugged</a>
          <a href="/collections/luxury-chronograph" class="site-nav__link">Luxury Series</a>
          <a href="/pages/about" class="site-nav__link">Engineering Heritage</a>
          <a href="/pages/support" class="site-nav__link">Support & FAQs</a>
        {%- endif -%}
      </nav>

      <!-- Header Action Icons -->
      <div class="site-header__actions">
        <!-- Search Trigger -->
        <a href="{{ routes.search_url }}" class="btn-icon" data-search-toggle aria-label="Search watches">
          {% render 'icon-search' %}
        </a>

        <!-- Account -->
        {%- if shop.customer_accounts_enabled -%}
          <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="btn-icon hidden-mobile" aria-label="Account">
            {% render 'icon-user' %}
          </a>
        {%- endif -%}

        <!-- Cart Button -->
        <button type="button" class="btn-icon" data-cart-drawer-toggle aria-label="Open shopping cart">
          {% render 'icon-cart' %}
          <span class="cart-count-badge" style="{% if cart.item_count == 0 %}display:none;{% endif %}">
            {{ cart.item_count }}
          </span>
        </button>

        <!-- CTA Header Button -->
        <a href="/products/kinetix-apex-pro" class="btn btn-primary btn-sm hidden-mobile" style="margin-left: 8px;">
          <span>Explore Apex Pro</span>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-drawer" style="position:fixed; top:0; left:-100%; width:85%; max-width:360px; height:100vh; background:var(--bg-card); z-index:2000; transition:left var(--transition-smooth); padding:24px; display:flex; flex-direction:column; box-shadow:var(--shadow-lg); border-right:1px solid var(--border-subtle);">
  <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:32px; padding-bottom:16px; border-bottom:1px solid var(--border-subtle);">
    <div class="site-header__logo">
      <span style="display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; background:var(--accent-gold); border-radius:6px; color:#090d16; font-weight:900; font-size:1rem;">K</span>
      <span style="font-size:1.3rem;">KINETIX PRO</span>
    </div>
    <button type="button" class="btn-icon mobile-nav-close" aria-label="Close navigation menu">
      {% render 'icon-close' %}
    </button>
  </div>

  <div style="display:flex; flex-direction:column; gap:18px; font-size:1.1rem; font-weight:600;">
    <a href="/" style="color:var(--text-primary);">Home</a>
    <a href="/collections/all" style="color:var(--text-primary);">All Smartwatches</a>
    <a href="/collections/military-rugged" style="color:var(--text-primary);">Military Rugged GPS</a>
    <a href="/collections/luxury-chronograph" style="color:var(--text-primary);">Luxury Chronograph Series</a>
    <a href="/pages/about" style="color:var(--text-primary);">The Kinetix Heritage</a>
    <a href="/pages/support" style="color:var(--text-primary);">Support & FAQs</a>
  </div>

  <div style="margin-top:auto; padding-top:24px; border-top:1px solid var(--border-subtle); display:flex; flex-direction:column; gap:12px;">
    <a href="/products/kinetix-apex-pro" class="btn btn-primary btn-full">Shop Apex Pro Smartwatch</a>
    <p style="font-size:0.82rem; color:var(--text-muted); text-align:center;">2-Year Global Warranty & 24/7 Support</p>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "default": 140,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable Sticky Header",
      "default": true
    }
  ]
}
{% endschema %}
