<section class="section-spacing" id="BrandHeritage-{{ section.id }}" style="position: relative; overflow: hidden;">
  <div class="container">
    <div class="grid grid-cols-2" style="align-items: center; gap: clamp(36px, 6vw, 72px);">
      <!-- Left: Heritage Laboratory Imagery -->
      <div style="position: relative;">
        <div style="position: relative; border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-lg);">
          <img
            src="{{ 'engineering-heritage.jpg' | asset_url }}"
            alt="The Kinetix Engineering Heritage & Watchmaking Lab"
            style="width: 100%; height: 100%; object-fit: cover; display: block;"
            loading="lazy"
            width="800"
            height="450"
          >
          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 24px; background: linear-gradient(0deg, rgba(9,13,22,0.95) 0%, transparent 100%);">
            <span class="badge badge-new" style="margin-bottom: 6px;">ZURICH • TOKYO • BOULDER</span>
            <div style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary);">ISO 9001 & MIL-STD-810H Cleanroom Assembly</div>
          </div>
        </div>

        <!-- Floating Heritage Badge -->
        <div class="glass-card" style="position: absolute; -top: 20px; -left: 20px; padding: 14px 22px; border-radius: var(--radius-md); box-shadow: var(--shadow-lg); z-index: 2; top: -16px; left: -16px;">
          <div style="font-size: 1.6rem; font-weight: 800; color: var(--accent-gold); font-family: var(--font-heading);">0.002mm</div>
          <div style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em;">Micro-CNC Tolerance</div>
        </div>
      </div>

      <!-- Right: Story Content -->
      <div class="brand-heritage-content">
        <span class="section-subtitle">{{ section.settings.subtitle | default: 'Engineering Heritage' }}</span>
        <h2 style="font-size: clamp(2rem, 3.5vw, 2.8rem); margin-bottom: 20px; line-height: 1.15;">
          WHERE SWISS HOROLOGY MEETS AEROSPACE TELEMETRY
        </h2>
        <p style="font-size: 1.05rem; color: var(--text-secondary); margin-bottom: 20px; line-height: 1.7;">
          Founded by aerospace materials engineers and veteran Swiss horologists, Kinetix Pro was born from a singular obsession: to build smartwatches that refuse to compromise between tactical indestructibility and mechanical luxury elegance.
        </p>
        <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 28px; line-height: 1.6;">
          Every single case is milled from solid billets of Grade 5 titanium, cryogenically hardened, and hand-inspected under high-power optical microscopes before receiving its proprietary BioPulse™ photodiode array.
        </p>

        <!-- 3 Feature Points -->
        <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 36px;">
          <div style="display: flex; align-items: flex-start; gap: 14px;">
            <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; color: var(--accent-gold); flex-shrink: 0; margin-top: 2px;">
              {% render 'icon-shield' %}
            </div>
            <div>
              <h4 style="font-size: 1.05rem; margin-bottom: 4px;">Extreme Polar & Desert Survival</h4>
              <p style="font-size: 0.88rem; color: var(--text-secondary);">Tested from -40°C Arctic conditions to +70°C Sahara desert humidity without performance degradation.</p>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 14px;">
            <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; color: var(--accent-emerald); flex-shrink: 0; margin-top: 2px;">
              {% render 'icon-heart' %}
            </div>
            <div>
              <h4 style="font-size: 1.05rem; margin-bottom: 4px;">Clinical BioPulse™ 8-Photodiode Engine</h4>
              <p style="font-size: 0.88rem; color: var(--text-secondary);">Dual-wavelength optical sensors continuous recording of ECG arrhythmia, arterial oxygen, and deep sleep architecture.</p>
            </div>
          </div>
        </div>

        <a href="/pages/about" class="btn btn-secondary btn-lg">
          <span>Read The Complete Heritage Story</span>
          {% render 'icon-arrow' %}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Heritage",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Engineering Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHERE SWISS HOROLOGY MEETS AEROSPACE TELEMETRY"
    }
  ],
  "presets": [
    {
      "name": "Brand Heritage"
    }
  ]
}
{% endschema %}
